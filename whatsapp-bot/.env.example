# Copy to .env and fill in. NEVER commit .env.

# Your Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model. Default is Claude Opus 4.8 (most capable). For high-volume customer
# service you may prefer a cheaper/faster model — claude-haiku-4-5 or
# claude-sonnet-4-6 — at the cost of some quality. Your call.
CLAUDE_MODEL=claude-opus-4-8

# The WhatsApp number that should receive escalations + approval requests.
# Full international format, no "+" or spaces, then @c.us. e.g. India 98765 43210:
OWNER_NUMBER=919876543210@c.us

# Confidence (0-1) below which the bot escalates instead of auto-replying.
CONFIDENCE_THRESHOLD=0.75

# If true, the bot NEVER sends automatically — it drafts a reply and asks you
# to approve every message. Good for the first few days while you build trust.
APPROVAL_MODE=true

# Port for the local review dashboard
REVIEW_PORT=3000

# --- Telegram approvals (recommended) ----------------------------------------
# When TELEGRAM_BOT_TOKEN is set, escalations go to Telegram with Send/Dismiss
# buttons (and you can reply with your own wording). Leave both blank to use the
# WhatsApp-forward + web dashboard instead.
#
# 1. Create a bot: message @BotFather on Telegram, /newbot, copy the token.
# 2. Put the token below, leave TELEGRAM_CHAT_ID blank, start the bot.
# 3. Send your bot any message — it replies with your chat id.
# 4. Paste that id into TELEGRAM_CHAT_ID and restart.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
